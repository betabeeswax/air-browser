<Window
    x:Class="AIRBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="AIR Browser">

    <Grid x:Name="RootLayout" Background="#05070C">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Custom top chrome (not default Windows title bar style) -->
        <Border Grid.Row="0" Background="#0A101A" BorderBrush="#152033" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- AIR brand mark -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#1D6FE8">
                        <TextBlock Text="A" FontSize="16" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="AIR" FontSize="15" FontWeight="Bold" Foreground="#F0F6FF" CharacterSpacing="120"/>
                        <TextBlock Text="BROWSER" FontSize="9" Foreground="#5B7A9E" CharacterSpacing="180"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center address area -->
                <Border Grid.Column="1" Margin="28,8" Background="#101826" CornerRadius="10"
                        BorderBrush="#1E2E45" BorderThickness="1" Height="34" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SearchEnginePicker" Width="96" Margin="4,0,0,0"
                                  VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                  SelectionChanged="SearchEnginePicker_SelectionChanged"/>
                        <TextBox x:Name="AddressBox" Grid.Column="1" Margin="4,0"
                                 PlaceholderText="Search or type a website"
                                 Background="Transparent" BorderThickness="0"
                                 KeyDown="AddressBox_KeyDown" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Go" Click="Go_Click" Margin="0,0,4,0"
                                Background="#1D6FE8" Foreground="White" CornerRadius="7" Padding="12,4"/>
                    </Grid>
                </Border>

                <!-- Right controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ComboBox x:Name="ProfilePicker" Width="110" PlaceholderText="Profile"
                              SelectionChanged="ProfilePicker_SelectionChanged"/>
                    <Button Content="+" Click="NewTab_Click" Width="34" Height="30"
                            ToolTipService.ToolTip="New tab (Ctrl+T)" CornerRadius="8"/>
                    <Button Content="..." Click="ShowSettings_Click" Width="34" Height="30"
                            ToolTipService.ToolTip="Settings" CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab row -->
        <Grid Grid.Row="1" Background="#080E18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:TabView x:Name="BrowserTabs" Height="38"
                              IsAddTabButtonVisible="False"
                              TabCloseRequested="BrowserTabs_TabCloseRequested"
                              SelectionChanged="BrowserTabs_SelectionChanged"
                              Background="Transparent"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,10,0" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="&lt;" Click="Back_Click" Width="30" Height="28" CornerRadius="7"
                        ToolTipService.ToolTip="Back"/>
                <Button x:Name="ForwardButton" Content="&gt;" Click="Forward_Click" Width="30" Height="28" CornerRadius="7"
                        ToolTipService.ToolTip="Forward"/>
                <Button Content="R" Click="Reload_Click" Width="30" Height="28" CornerRadius="7"
                        ToolTipService.ToolTip="Reload"/>
            </StackPanel>
        </Grid>

        <!-- Body: sidebar + page -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Custom sidebar -->
            <Border Grid.Column="0" Background="#0A101A" BorderBrush="#152033" BorderThickness="0,0,1,0">
                <Grid Margin="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="SidebarToggle" Content="&lt;" Click="SidebarToggle_Click" Width="28" Height="28" CornerRadius="7"
                                ToolTipService.ToolTip="Toggle sidebar"/>
                        <TextBlock x:Name="SidebarTitle" Text="AIR" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6B8AB0" VerticalAlignment="Center" CharacterSpacing="100"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="GROUPS" FontSize="10" Foreground="#4A6688" CharacterSpacing="80"/>
                        <ComboBox x:Name="TabGroupPicker" PlaceholderText="Move tab to group"
                                  SelectionChanged="TabGroupPicker_SelectionChanged"/>
                        <Button x:Name="NewGroupButton" Content="+ New group" Click="NewGroup_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                        <StackPanel x:Name="TabGroupsBar" Orientation="Vertical" Spacing="4"/>
                    </StackPanel>

                    <ListView x:Name="VerticalTabs" Grid.Row="2"
                              SelectionChanged="VerticalTabs_SelectionChanged"
                              Background="Transparent" BorderThickness="0" SelectionMode="Single"/>

                    <StackPanel Grid.Row="3" Spacing="4">
                        <Button x:Name="BookmarksSideButton" Content="Bookmarks" Click="ShowBookmarks_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                        <Button x:Name="PasswordsSideButton" Content="Passwords" Click="ShowPasswords_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                        <Button x:Name="HistorySideButton" Content="History" Click="ShowHistory_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                        <Button x:Name="DownloadsSideButton" Content="Downloads" Click="ShowDownloads_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content -->
            <Grid Grid.Column="1" x:Name="ContentHost" Background="#05070C"/>
        </Grid>

        <!-- Slim status bar -->
        <Border Grid.Row="3" Background="#0A101A" BorderBrush="#152033" BorderThickness="0,1,0,0" Padding="14,0">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#5B7A9E" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
