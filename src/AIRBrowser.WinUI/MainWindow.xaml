<Window
    x:Class="AIRBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AIR Browser">

    <Grid x:Name="RootLayout" Background="#05070C" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- AIR custom browser chrome -->
        <Border Grid.Row="0" Background="#0A101A" BorderBrush="#152033" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#1D6FE8">
                        <TextBlock Text="A" FontSize="19" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="AIR" FontSize="16" FontWeight="Bold" Foreground="#F0F6FF" CharacterSpacing="120"/>
                        <TextBlock Text="BROWSER" FontSize="9" Foreground="#5B7A9E" CharacterSpacing="180"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Margin="24,9" Background="#101826" CornerRadius="10"
                        BorderBrush="#1E2E45" BorderThickness="1" Height="36" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SearchEnginePicker" Width="104" Margin="4,0,0,0"
                                  VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                  SelectionChanged="SearchEnginePicker_SelectionChanged"/>
                        <TextBox x:Name="AddressBox" Grid.Column="1" Margin="4,0"
                                 PlaceholderText="Search or type a website"
                                 Background="Transparent" BorderThickness="0"
                                 KeyDown="AddressBox_KeyDown" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Go" Click="Go_Click" Margin="0,0,4,0"
                                Background="#1D6FE8" Foreground="White" CornerRadius="7" Padding="14,4"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <ComboBox x:Name="ProfilePicker" Width="112" PlaceholderText="Profile"
                              SelectionChanged="ProfilePicker_SelectionChanged"/>
                    <Button Content="+" Click="NewTab_Click" Width="34" Height="32"
                            ToolTipService.ToolTip="New tab (Ctrl+T)" CornerRadius="8"/>
                    <Button Content="•••" Click="ShowSettings_Click" Width="38" Height="32"
                            ToolTipService.ToolTip="Settings" CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Horizontal tab strip and navigation -->
        <Grid Grid.Row="1" Background="#080E18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel x:Name="BrowserTabsPanel" Orientation="Horizontal" Spacing="5" Padding="8,5"/>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,10,0" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="‹" Click="Back_Click" Width="30" Height="29" CornerRadius="8"
                        ToolTipService.ToolTip="Back"/>
                <Button x:Name="ForwardButton" Content="›" Click="Forward_Click" Width="30" Height="29" CornerRadius="8"
                        ToolTipService.ToolTip="Forward"/>
                <Button Content="↻" Click="Reload_Click" Width="30" Height="29" CornerRadius="8"
                        ToolTipService.ToolTip="Reload"/>
                <Button Content="☆" Click="Bookmark_Click" Width="32" Height="29" CornerRadius="8"
                        ToolTipService.ToolTip="Bookmark (Ctrl+D)"/>
            </StackPanel>
        </Grid>

        <!-- Sidebar and web page -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="205"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0A101A" BorderBrush="#152033" BorderThickness="0,0,1,0">
                <Grid Margin="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Button x:Name="SidebarToggle" Content="‹" Click="SidebarToggle_Click"
                                Width="30" Height="29" CornerRadius="8" ToolTipService.ToolTip="Collapse sidebar"/>
                        <TextBlock x:Name="SidebarTitle" Text="AIR SIDEBAR" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B8AB0" VerticalAlignment="Center" CharacterSpacing="100"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button x:Name="HorizontalTabsButton" Content="Horizontal" Click="HorizontalTabs_Click"
                                    Padding="8,5" CornerRadius="7" FontSize="11"/>
                            <Button x:Name="VerticalTabsButton" Content="Vertical" Click="VerticalTabs_Click"
                                    Padding="8,5" CornerRadius="7" FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="GroupLabel" Text="TAB GROUPS" FontSize="10" Foreground="#4A6688"
                                   CharacterSpacing="80"/>
                        <ComboBox x:Name="TabGroupPicker" PlaceholderText="Move tab to group"
                                  SelectionChanged="TabGroupPicker_SelectionChanged"/>
                        <Button x:Name="NewGroupButton" Content="+ New group" Click="NewGroup_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                        <StackPanel x:Name="TabGroupsBar" Orientation="Vertical" Spacing="4"/>
                    </StackPanel>

                    <ListView x:Name="VerticalTabs" Grid.Row="2" SelectionChanged="VerticalTabs_SelectionChanged"
                              Background="Transparent" BorderThickness="0" SelectionMode="Single"/>

                    <StackPanel Grid.Row="3" Spacing="5">
                        <Button x:Name="BookmarksSideButton" Content="Bookmarks" Click="ShowBookmarks_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                        <Button x:Name="PasswordsSideButton" Content="Passwords" Click="ShowPasswords_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                        <Button x:Name="HistorySideButton" Content="History" Click="ShowHistory_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                        <Button x:Name="DownloadsSideButton" Content="Downloads" Click="ShowDownloads_Click"
                                HorizontalAlignment="Stretch" CornerRadius="8"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" x:Name="ContentHost" Background="#05070C"/>
        </Grid>

        <Border Grid.Row="3" Background="#0A101A" BorderBrush="#152033" BorderThickness="0,1,0,0" Padding="14,0">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#5B7A9E"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>