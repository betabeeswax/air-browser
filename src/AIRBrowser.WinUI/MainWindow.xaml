<Window
    x:Class="AIRBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AIR Browser">
    <Grid x:Name="RootLayout" Background="#05070C">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0A101A" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" Background="#1D6FE8" Margin="0,0,10,0">
                    <TextBlock Text="A" FontSize="16" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="AIR Browser" FontSize="16" FontWeight="Bold" Foreground="#F0F6FF" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Column="1" Margin="16,10,16,10" Background="#121A28" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SearchEnginePicker" Margin="4,2,0,2" VerticalAlignment="Center"
                          SelectionChanged="SearchEnginePicker_SelectionChanged"/>
                <TextBox x:Name="AddressBox" Grid.Column="1" Margin="4,2,4,2" VerticalAlignment="Center"
                         PlaceholderText="Search or type a website"
                         KeyDown="AddressBox_KeyDown"/>
                <Button Grid.Column="2" Content="Go" Click="Go_Click" Margin="4,2,6,2"
                        Background="#1D6FE8" Foreground="White" Padding="14,4"/>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="ProfilePicker" Width="120" PlaceholderText="Profile" Margin="0,0,6,0"
                          SelectionChanged="ProfilePicker_SelectionChanged"/>
                <Button Content="+" Click="NewTab_Click" Width="34" Height="30" Margin="0,0,6,0"/>
                <Button Content="..." Click="ShowSettings_Click" Width="34" Height="30"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="#080E18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,6,8,6" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="&lt;" Click="Back_Click" Width="30" Height="28" Margin="0,0,4,0"/>
                <Button x:Name="ForwardButton" Content="&gt;" Click="Forward_Click" Width="30" Height="28" Margin="0,0,4,0"/>
                <Button Content="R" Click="Reload_Click" Width="30" Height="28"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel x:Name="BrowserTabsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            </ScrollViewer>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <Button x:Name="HorizontalTabsButton" Content="H" Click="HorizontalTabs_Click" Width="30" Height="28" Margin="0,0,4,0"/>
                <Button x:Name="VerticalTabsButton" Content="V" Click="VerticalTabs_Click" Width="30" Height="28"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0A101A" BorderBrush="#152033" BorderThickness="0,0,1,0">
                <Grid Margin="10,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SidebarToggle" Content="&lt;" Click="SidebarToggle_Click" Width="28" Height="28" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SidebarTitle" Text="AIR" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#6B8AB0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock x:Name="GroupLabel" Text="GROUPS" FontSize="10" Foreground="#4A6688" Margin="0,0,0,6"/>
                        <ComboBox x:Name="TabGroupPicker" PlaceholderText="Move tab to group" Margin="0,0,0,6"
                                  SelectionChanged="TabGroupPicker_SelectionChanged"/>
                        <Button x:Name="NewGroupButton" Content="+ New group" Click="NewGroup_Click"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <StackPanel x:Name="TabGroupsBar" Orientation="Vertical"/>
                    </StackPanel>

                    <ListView x:Name="VerticalTabs" Grid.Row="2"
                              SelectionChanged="VerticalTabs_SelectionChanged"
                              Background="Transparent" BorderThickness="0" SelectionMode="Single"/>

                    <StackPanel Grid.Row="3">
                        <Button x:Name="BookmarksSideButton" Content="Bookmarks" Click="ShowBookmarks_Click"
                                HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                        <Button x:Name="PasswordsSideButton" Content="Passwords" Click="ShowPasswords_Click"
                                HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                        <Button x:Name="HistorySideButton" Content="History" Click="ShowHistory_Click"
                                HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                        <Button x:Name="DownloadsSideButton" Content="Downloads" Click="ShowDownloads_Click"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="ContentHost" Background="#05070C"/>
        </Grid>

        <Border Grid.Row="3" Background="#0A101A" Padding="12,0,12,0">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#5B7A9E" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
