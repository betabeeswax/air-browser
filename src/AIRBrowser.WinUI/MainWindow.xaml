<Window
    x:Class="AIRBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="AIR Browser">
    <Grid Background="#080D16" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0D1726">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="12,8">
                <Border Width="30" Height="30" CornerRadius="9" Background="#1768D6">
                    <TextBlock Text="A" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="AIR" FontSize="17" FontWeight="Bold" CharacterSpacing="160" Foreground="#EAF3FF" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,8,12,8">
                <ComboBox x:Name="ProfilePicker" Width="145" PlaceholderText="Profile" SelectionChanged="ProfilePicker_SelectionChanged"/>
                <Button Content="＋ New tab" Click="NewTab_Click"/>
                <Button Content="☰" Click="ShowSettings_Click" ToolTipService.ToolTip="Settings and sync"/>
            </StackPanel>
        </Grid>

        <controls:TabView x:Name="BrowserTabs" Grid.Row="1" IsAddTabButtonVisible="True"
                          AddTabButtonClick="BrowserTabs_AddTabButtonClick"
                          TabCloseRequested="BrowserTabs_TabCloseRequested"
                          SelectionChanged="BrowserTabs_SelectionChanged"
                          Background="#0D1726" Foreground="#EAF3FF"/>

        <Grid Grid.Row="2" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#101C2D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="←" Click="Back_Click" ToolTipService.ToolTip="Back"/>
                <Button x:Name="ForwardButton" Grid.Column="1" Content="→" Click="Forward_Click" ToolTipService.ToolTip="Forward"/>
                <Button Grid.Column="2" Content="↻" Click="Reload_Click" ToolTipService.ToolTip="Reload"/>
                <TextBox x:Name="AddressBox" Grid.Column="3" Margin="8,0" PlaceholderText="Search Bing or enter a website address" KeyDown="AddressBox_KeyDown" VerticalContentAlignment="Center"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3">
                    <Button Content="☆" Click="Bookmark_Click" ToolTipService.ToolTip="Bookmark this page"/>
                    <Button Content="Bookmarks" Click="ShowBookmarks_Click"/>
                    <Button Content="History" Click="ShowHistory_Click"/>
                    <Button Content="Downloads" Click="ShowDownloads_Click"/>
                </StackPanel>
                <ComboBox x:Name="SearchEnginePicker" Grid.Column="5" Width="125" Margin="8,0" SelectionChanged="SearchEnginePicker_SelectionChanged"/>
                <Button Grid.Column="6" Content="Go" Click="Go_Click"/>
            </Grid>
            <Grid Grid.Row="1" x:Name="ContentHost" Background="#080D16"/>
        </Grid>

        <Border Grid.Row="3" Background="#0D1726" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="Ready • AIR Browser preview" FontSize="12" Foreground="#8FA8C8"/>
        </Border>
    </Grid>
</Window>